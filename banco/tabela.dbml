//tabela do supabase
Table auth.users {
  id uuid [pk]
}

Table perfil {
  user_id uuid [pk, not null, ref: > auth.users.id]
  email varchar(50) [not null, unique]
  senha varchar(50) [not null]
}

Table arquetipo {
  id serial [pk]
  nome varchar(20)
  descricao text
}

Table atributos {
  id serial [pk]
  nome varchar(20)
  descricao text
}

Table ficha {
  id serial [pk]
  nome_jogador varchar(50)
  vida int [note: 'CHECK (vida <= 6)']
  dados int [note: 'CHECK (dados <= 6)']
  habilidades text
  id_arquetipo int [ref: > arquetipo.id]
  id_atributos int [ref: > atributos.id]
  user_id uuid [not null, ref: > auth.users.id]
}